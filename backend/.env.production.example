APP_NAME=StudIA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://studia.ejemplo.edu.mx

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
STUDIA_TIMEZONE=America/Mexico_City

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studia
DB_USERNAME=studia
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT=90
GEMINI_MAX_INLINE_MB=15

STUDIA_VENCIDAS_COMO_CERO=true

# Vacío si el frontend y la API comparten dominio
CORS_ALLOWED_ORIGINS=